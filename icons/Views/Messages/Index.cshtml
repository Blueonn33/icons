@model AllMessagesViewModel
@{
    ViewData["Title"] = "Message";
    ViewData["BodyClass"] = "messages-body";
}

<div class="messages-container container">
    <a class="btn btn-light" asp-action="UserProfile" asp-controller="Users" asp-route-id="@Model.ReceiverId">назад</a>

    <div class="messages-user-profile d-flex align-items-center flex-column">
        <div class="messages-user-profile-container">
            <img src="@Model.ReceiverProfilePic" class="img-fluid messages-user-profile-pic"/>
        </div>
        <div class="my-3">
            <p class="text-light">@Model.ReceiverName</p>
        </div>
    </div>

    <div class="messages-content">
        <div class="messages-messages">
            @foreach (var message in Model.Messages)
            {
                if (message is MessageSenderViewModel)
                {
                    <partial name="_SenderMessagePartial" model="message" />
                }
                else if (message is MessageReceiverViewModel)
                {
                    <partial name="_ReceiverMessagePartial" model="message" />
                }
            }
        </div>

        <form class="messages-form">
            <div class="d-flex gap-3">
                <input type="text" class="form-control" placeholder="съобщение.."/>
                <button type="submit" class="btn btn-light">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send" viewBox="0 0 16 16">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z"/>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</div>