@model icons.Models.Reviews.ReviewsUpdateViewModel;

<section>
    <div class="modal fade" id="update-review-modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Modal title</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="UpdateReview" asp-controller="Reviews" method="post">
                    <div class="modal-body">
                        <input asp-for="@Model.Id" type="hidden" id="review-id" />
                        
                        <div class="mb-3">
                            <label asp-for="@Model.Title" class="form-label">title</label>
                            <input asp-for="@Model.Title" class="form-control" id="review-title"/>
                        </div> 
                        <div class="mb-3">
                            <label asp-for="@Model.Description" class="form-label">description</label>
                            <input asp-for="@Model.Description" class="form-control" id="review-description" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>