@using icons.Data.Enums
@model icons.Models.Reviews.ReviewsCreateViewModel;

<section class="container p-0">
    <form class="add-review-form border rounded-3 p-3 text-light mb-5" asp-action="CreateReview" asp-controller="Reviews" method="post">
        <input type="hidden" asp-for="IconId" />

        <div class="mb-3">
            <label asp-for="@Model.Title"></label>
            <input class="form-control" asp-for="@Model.Title"/>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Description"></label>
            <textarea class="form-control" asp-for="@Model.Description"></textarea>
        </div>
        @* <div>
            <select asp-for="@Model.Rating">
                <option value="@EnumReviewRating.Poor">1</option>
                <option value="@EnumReviewRating.Fair">2</option>
                <option value="@EnumReviewRating.Good">3</option>
                <option value="@EnumReviewRating.VeryGood">4</option>
                <option value="@EnumReviewRating.Excellent">5</option>
            </select>
        </div> *@
        <div class="row">
            <div class="rating-select d-flex gap-3 col">
                <label class="bg-white rounded-circle">
                    <input type="radio" asp-for="Rating" value="@EnumReviewRating.Poor" class="d-none"/>
                    <img src="~/img/blaw.svg" class="rating-img"/>
                </label>
                <label class="bg-white rounded-circle">
                    <input type="radio" asp-for="Rating" value="@EnumReviewRating.Fair" class="d-none"/>
                    <img src="~/img/color-sad.svg" class="rating-img"/>
                </label>
                <label class="bg-white rounded-circle">
                    <input type="radio" asp-for="Rating" value="@EnumReviewRating.Good" class="d-none"/>
                    <img src="~/img/color-pocker.svg" class="rating-img"/>
                </label >
                <label class="bg-white rounded-circle">
                    <input type="radio" asp-for="Rating" value="@EnumReviewRating.VeryGood" class="d-none"/>
                    <img src="~/img/color-smile.svg" class="rating-img"/>
                </label>
                <label class="bg-white rounded-circle">
                    <input type="radio" asp-for="Rating" value="@EnumReviewRating.Excellent" class="d-none"/>
                    <img src="~/img/color-cool.svg" class="rating-img"/>
                </label>
            </div>
            <div class="col d-flex justify-content-end">
                <button class="btn btn-secondary" type="submit">Add</button>
            </div>
        </div>
    </form>
</section>