@using System.Security.Claims
@using icons.Core.Enums
@using icons.Data.Constants
@using icons.Data.Enums
@using icons.Models.Reviews
@model icons.Models.Reviews.ReviewsViewModel

<section class="container mt-5 pb-5">
    <div class="mb-4">
        <h2 class="text-light">add a review</h2>
    </div>
    <section>
        @await Html.PartialAsync(
            "~/Views/Reviews/_CreateReview.cshtml",
            new ReviewsCreateViewModel { IconId = Model.IconId }
        )
    </section>
    <section>
        @await Html.PartialAsync("~/Views/Reviews/_UpdateReview.cshtml", new ReviewsUpdateViewModel())
    </section>
    <section class="my-3">
        <form method="get" asp-action="Icon" asp-controller="Icons">
            <input type="hidden" name="id" value="@Model.IconId" />
            
            <div class="row d-flex justify-content-end">
                <div class="col-2">
                    <select class="form-select" asp-for="Sort"
                            asp-items="Html.GetEnumSelectList<EnumReviewSortOptions>()"
                            onchange="this.form.submit()">
                    </select>
                </div>
            </div>
        </form>

    </section>
    @foreach (var review in Model.Reviews)
    {
        <div class="row get-review-container border rounded-3 text-light mb-3 position-relative">
            <div class="col-1 ps-0">
                <img src="@review.UserProfilePictureUrl" class="img-fluid rounded-start-3"/>
            </div>
            <div class="col-10">
                <div class="d-flex gap-5">
                    <div>
                        <p class="mb-0">@review.Username</p>
                        <img src="@Model.RankImageUrl" class="img-fluid user-rank-img" data-bs-toggle="tooltip" data-bs-placement="top"
                             data-bs-custom-class="custom-tooltip"
                             data-bs-title="@Model.Rank"/>
                    </div>
                    <p class="mb-0">@review.PublishedTime.ToShortDateString()</p>
                </div>
                <hr class="my-1"/>
                <div>
                    <h4>@review.Title</h4>
                </div>
                <div>
                    <p class="mb-0 pb-2">@review.Description</p>
                </div>
            </div>
            <div class="col-1 d-flex align-items-center justify-content-center">
                <div>
                    <img src="@(review.Rating switch
                              {
                                  EnumReviewRating.Poor => Url.Content("~/img/color-blaw.svg"),
                                  EnumReviewRating.Fair => Url.Content("~/img/color-sad.svg"),
                                  EnumReviewRating.Good => Url.Content("~/img/color-pocker.svg"),
                                  EnumReviewRating.VeryGood => Url.Content("~/img/color-smile.svg"),
                                  EnumReviewRating.Excellent => Url.Content("~/img/color-cool.svg"),
                              })" class="img-fluid"

                         data-bs-toggle="tooltip" data-bs-placement="top"
                         data-bs-custom-class="custom-tooltip"
                         data-bs-title="@review.Rating"/>

                </div>
            </div>
            @{
                bool isAuthenticated = User.Identity.IsAuthenticated &&
                                       review.UserId == User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (isAuthenticated || User.IsInRole(Roles.Admin))
                {
                    <div class="d-flex align-items-center gap-1 p-1">
                        @if (isAuthenticated || !User.IsInRole(Roles.Admin))
                        {
                            <button class="btn btn-sm btn-warning"
                                    data-id="@review.Id"
                                    data-title="@review.Title"
                                    data-description="@review.Description"
                                    onclick="openUpdateModal(this)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="0.8rem" height="0.8rem" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                    <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                                    <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>
                                </svg>
                            </button>
                        }
                        <form asp-action="DeleteReview" asp-controller="Reviews" asp-route-id="@review.Id" method="post">
                            <button class="btn btn-sm btn-danger" onclick="return confirm('are you sure? 🤨');">
                                <svg xmlns="http://www.w3.org/2000/svg" width="0.8rem" height="0.8rem" fill="currentColor"
                                     class="bi bi-trash-fill" viewBox="0 0 16 16">
                                    <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                }
            }
        </div>
    }
</section>
<script>
    function openUpdateModal(button) {
        const id = button.getAttribute("data-id");
        const title = button.getAttribute("data-title");
        const description = button.getAttribute("data-description");

        document.getElementById("review-id").value = id;
        document.getElementById("review-title").value = title;
        document.getElementById("review-description").value = description;

        var modal = new bootstrap.Modal(document.getElementById("update-review-modal"));
        modal.show();
    }
</script>