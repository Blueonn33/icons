@using icons.Data.Enums
@model icons.Models.Reviews.ReviewsViewModel

<section class="container mt-5 ">
    <div class="mb-4">
        <h1>reviews</h1>
    </div>
    @foreach (var review in Model.Reviews)
    {
        <div class="row get-review-container border rounded-3 text-light">
            <div class="col-1 ps-0">
                <img src="@review.UserProfilePictureUrl" class="img-fluid rounded-start-3"/>
            </div>
            <div class="col-10">
                <div class="d-flex gap-5">
                    <p class="mb-0">@review.Username</p>
                    <p class="mb-0">@review.PublishedTime.ToShortDateString()</p>
                </div>
                <hr class="my-1"/>
                <div>
                    <h4>@review.Title</h4>
                </div>
                <div>
                    <p class="mb-0 pb-1">@review.Description</p>
                </div>
            </div>
            <div class="col-1 d-flex align-items-center justify-content-center">
                <div>
                    <img src="@(review.Rating switch
                              {
                                  EnumReviewRating.Poor => Url.Content("~/img/color-blaw.png"),
                                  EnumReviewRating.Fair => Url.Content("~/img/color-sad.png"),
                                  EnumReviewRating.Good => Url.Content("~/img/color-pocker.png"),
                                  EnumReviewRating.VeryGood => Url.Content("~/img/color-smile.svg"),
                                  EnumReviewRating.Excellent => Url.Content("~/img/color-cool.png"),
                              })" class="img-fluid"/>

                </div>
            </div>
        </div>
    }
</section>

@* Poor = 1,
Fair = 2,
Good = 3,
VeryGood = 4,
Excellent = 5 *@