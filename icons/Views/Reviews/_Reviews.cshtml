@using icons.Data.Enums
@using icons.Models.Reviews
@model icons.Models.Reviews.ReviewsViewModel

<section class="container mt-5 pb-5">
    <div class="mb-4">
        <h2>add a review</h2>
    </div>
    <section>
        @await Html.PartialAsync(
            "~/Views/Reviews/_CreateReview.cshtml",
            new ReviewsCreateViewModel{ IconId = Model.IconId }
        )
    </section>
    @foreach (var review in Model.Reviews)
    {
        <div class="row get-review-container border rounded-3 text-light mb-3">
            <div class="col-1 ps-0">
                <img src="@review.UserProfilePictureUrl" class="img-fluid rounded-start-3"/>
            </div>
            <div class="col-10">
                <div class="d-flex gap-5">
                    <p class="mb-0">@review.Username</p>
                    <p class="mb-0">@review.PublishedTime.ToShortDateString()</p>
                </div>
                <hr class="my-1"/>
                <div>
                    <h4>@review.Title</h4>
                </div>
                <div>
                    <p class="mb-0 pb-1">@review.Description</p>
                </div>
            </div>
            <div class="col-1 d-flex align-items-center justify-content-center">
                <div>
                    <img src="@(review.Rating switch
                              {
                                  EnumReviewRating.Poor => Url.Content("~/img/color-blaw.svg"),
                                  EnumReviewRating.Fair => Url.Content("~/img/color-sad.svg"),
                                  EnumReviewRating.Good => Url.Content("~/img/color-pocker.svg"),
                                  EnumReviewRating.VeryGood => Url.Content("~/img/color-smile.svg"),
                                  EnumReviewRating.Excellent => Url.Content("~/img/color-cool.svg"),
                              })" class="img-fluid"

                         data-bs-toggle="tooltip" data-bs-placement="top"
                         data-bs-custom-class="custom-tooltip"
                         data-bs-title="@review.Rating"
                         />

                </div>
            </div>
        </div>
    }
</section>