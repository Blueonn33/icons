@model ReviewsUpdateViewModel;

<section>
    <div class="modal fade" id="update-review-modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">редакция</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="UpdateReview" asp-controller="Reviews">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="modal-body">
                        <input asp-for="Id" type="hidden" id="review-id"/>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">заглавие</label>
                            <input asp-for="Title" class="form-control" id="review-title"/>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">описание</label>
                            <input asp-for="Description" class="form-control" id="review-description"/>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">затвори</button>
                        <button type="submit" class="btn btn-primary">запиши</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>