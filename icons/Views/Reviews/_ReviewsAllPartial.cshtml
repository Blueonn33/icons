@using icons.Data.Enums
@model ReviewsAllViewModel

<section class="container mt-5 pb-5 body-container">
    <div class="mb-4">
        <h2 class="text-light">напиши ревю</h2>
    </div>
    <section>
        <partial name="~/Views/Reviews/_CreateReviewPartial.cshtml" model="@(new ReviewInputModel { IconId = Model.IconId })" />
    </section>
    <section>
        <partial name="~/Views/Reviews/_UpdateReviewPartial.cshtml" model="@(new ReviewInputModel())" />
    </section>
    @if (Model.Reviews.Any())
    {
        <section class="my-3">
            <form method="get" asp-action="Icon" asp-controller="Icons">
                <input type="hidden" name="id" value="@Model.IconId" />
            
                <div class="row d-flex justify-content-end">
                    <div class="col-sm-4 col-md-3 col-lg-2">
                        <select class="form-select" asp-for="Sort"
                                asp-items="Html.GetEnumSelectList<EnumReviewSortOptions>()"
                                onchange="this.form.submit()">
                        </select>
                    </div>
                </div>
            </form>
        </section>
    }
    else
    {
        <div class="container mt-5" style="padding-bottom: 20vh">
            <hr/>
            <p class="fs-5 text-light">бъди първия написал ревю</p>
            <hr/>
        </div>
    }
    
    @foreach (var review in Model.Reviews)
    {
        <div class="row get-review-container border rounded-3 text-light mb-3 position-relative">
            <partial name="~/Views/Reviews/_ReviewPartial.cshtml" model="review"/>
            <partial name="~/Views/Reviews/_ReviewModalScriptsPartial.cshtml" model="review"/>
        </div>
    }
</section>
<section>
    <button id="backToTop" class="back-to-top">
        ↑
    </button>
</section>

@section Scripts
{
    <script name="_ScrollPartial.cshtml"></script>
    <partial name="_ValidationScriptsPartial" />
}