@using icons.Data.Constants
@using icons.Data.Enums
@model icons.Models.Users.UserProfileViewModel;
@{
    ViewData["Title"] = "User";
    ViewData["BodyClass"] = "users-index-body";
}

<div class="user-profile-container">
    <section class="container mt-5">
        @if (User.IsInRole(Roles.Admin))
        {
            <section class="mb-5">
                <a class="btn btn-secondary" asp-action="Index" asp-controller="Users">назад</a>
            </section>
        }
        <div class="row text-light">
            <div class="col-sm-12 col-md-3 d-flex justify-content-center">
                <div class="col-4 col-sm-6 col-md-12 mb-3">
                    <img src="@Model.ProfilePictureUrl" class="img-fluid rounded-3 current-user-profile-img" />
                </div>
            </div>
            <div class="col-sm-12 col-md-9">
                <div class="d-flex justify-content-between align-items-center">
                    <partial name="_RanksPartial.cshtml" model="Model"/>
                    <div class="d-flex align-items-center gap-1 bg-white p-2 rounded-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1.5rem" height="1.5rem" fill="#431264" class="bi bi-droplet-fill" viewBox="0 0 16 16">
                            <path d="M8 16a6 6 0 0 0 6-6c0-1.655-1.122-2.904-2.432-4.362C10.254 4.176 8.75 2.503 8 0c0 0-6 5.686-6 10a6 6 0 0 0 6 6M6.646 4.646l.708.708c-.29.29-1.128 1.311-1.907 2.87l-.894-.448c.82-1.641 1.717-2.753 2.093-3.13"/>
                        </svg>
                        <span class="fs-4" style="color: #431264;">@Model.Elixir</span>
                    </div>
                </div>
                <hr/>
                <div>
                    <p class="fs-5 text-dark-emphasis"><strong class="text-light">брой икони: </strong>@Model.IconsCount</p>
                    <p class="fs-5 text-dark-emphasis"><strong class="text-light">брой ревюта: </strong>@Model.ReviewsCount</p>
                </div>
                <hr/>
                <p class="fs-5 text-dark-emphasis"><strong class="text-light">дата на регистрация: </strong>@Model.DateRegistered.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </p>
            </div>
        </div>
    </section>
    <section class="row text-light mt-5 d-flex justify-content-center mx-2">
        <div class="col-10">
            <h2 class="mb-4">икони</h2>
            <hr class="text-light mb-0"/>

            @if (!Model.Icons.Any())
            {
                <p class="fs-5 mt-3">няма налични икони</p>
            }
            else
            {
                <div class="row d-flex justify-content-center my-3 gap-3">
                    @foreach (var icon in Model.Icons)
                    {
                        <partial name="~/Views/Icons/_IconPartial.cshtml" model="icon"/>
                    }
                </div>
            }

            <hr class="text-light"/>
        </div>
    </section>
    <section class="row text-light mt-5 d-flex justify-content-center mx-2">
        <div class="col-10">
            <h2 class="mb-4">ревюта</h2>
            <hr class="text-light mb-0" />

            @if (!Model.Reviews.Any())
            {
                <div class="mt-3">
                    <p class="fs-5">няма налични ревюта</p>
                </div>
            }
            else
            {
                <div class="row d-flex justify-content-center mt-3">
                    @foreach (var review in Model.Reviews)
                    {
                        <partial name="~/Views/Reviews/_ReviewUserProfilePartial.cshtml" model="review"/>
                    }
                </div>
            }
            <hr class="text-light" />
        </div>
    </section>
</div>