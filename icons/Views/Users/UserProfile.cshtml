@using icons.Data.Enums
@model icons.Models.Users.UserProfileViewModel;
@{
    ViewData["Title"] = "User";
}

<head>
    <link rel="stylesheet" href="~/css/users/user-profile.css" asp-append-version="true" />
</head>
<body>
    <section class="container mt-5">
        <section class="mb-5">
            <a class="btn btn-secondary" asp-action="Index" asp-controller="Users">back</a>
        </section>
        <div class="row text-light">
            <div class="col-3">
                <img src="@Model.ProfilePictureUrl" class="img-fluid rounded-3 current-user-profile-img"/>
            </div>
            <div class="col">
                <p class="fs-3">@Model.Name</p>
                <hr/>
                <p class="fs-5 text-dark-emphasis"><strong class="text-light">email: </strong>@Model.Email</p>
                <hr/>
                <p class="fs-5 text-dark-emphasis"><strong class="text-light">icons count: </strong>@Model.IconsCount</p>
                <hr/>
                <p class="fs-5 text-dark-emphasis"><strong class="text-light">reviews count: </strong>@Model.ReviewsCount</p>
                <hr/>
                <p class="fs-5 text-dark-emphasis"><strong class="text-light">date registered: </strong>-</p>
            </div>
        </div>
    </section>
    <section class="row text-light mt-5 user-content-container">
        <h2 class="mb-4">icons</h2>
        <hr class="text-light mb-0" />

        @if (!Model.Icons.Any())
        {
            <p class="fs-5 mt-3">no icons available</p>
        }
        else
        {
            @foreach (var icon in Model.Icons)
            {
                <p>@icon.Title</p>
            }
        }

        <hr class="text-light" />
    </section>
    <section class="text-light mt-5 user-content-container">
        <h2 class="mb-4">reviews</h2>
        <hr class="text-light mb-0" />

        @if (!Model.Reviews.Any())
        {
            <div class="mt-3">
                <p class="fs-5">no reviews available</p>
            </div>
        }
        else
        {
            @foreach (var review in Model.Reviews)
            {
                <div class="col-6 user-review-container bg-light rounded-3 m-2 text-dark p-3 border-info border-5 border shadow">
                    <div class="row">
                        <small>@review.PublishedTime</small>
                        <div class="col-11">
                            <p class="fs-5">@review.Title</p>
                            <p class="fs-5 mb-0">@review.Description</p>
                        </div>
                        <div class="col-1 d-flex">
                            <img src="@(review.Rating switch
                                      {
                                          EnumReviewRating.Poor => Url.Content("~/img/color-blaw.svg"),
                                          EnumReviewRating.Fair => Url.Content("~/img/color-sad.svg"),
                                          EnumReviewRating.Good => Url.Content("~/img/color-pocker.svg"),
                                          EnumReviewRating.VeryGood => Url.Content("~/img/color-smile.svg"),
                                          EnumReviewRating.Excellent => Url.Content("~/img/color-cool.svg"),
                                      })" class="img-fluid"/>
                        </div>
                    </div>
                </div>
            }
        }

        <hr class="text-light" />
    </section>
</body>