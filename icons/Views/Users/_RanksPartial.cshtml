@model icons.Models.Users.UserProfileViewModel;

<div class="d-flex">
    <p class="fs-3 mb-0 align-self-center">@Model.Name</p>
    <button type="button" class="border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#ranksModal">
        <img src="@Model.RankImageUrl" class="img-fluid user-rank-img" data-bs-toggle="tooltip" data-bs-placement="top"
                data-bs-custom-class="custom-tooltip"
                data-bs-title="@Model.Rank"/>
    </button>

    <div class="modal fade" id="ranksModal" tabindex="-1" aria-labelledby="ranksModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5 text-dark" id="ranksModalLabel">всички рангове</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="list-group">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <img src="/img/ranks/newbie.png" class="img-fluid" width="40px" />
                                <svg xmlns="http://www.w3.org/2000/svg" width="1.5rem" height="1.5rem" fill="#431264" class="bi bi-droplet-fill" viewBox="0 0 16 16">
                                    <path d="M8 16a6 6 0 0 0 6-6c0-1.655-1.122-2.904-2.432-4.362C10.254 4.176 8.75 2.503 8 0c0 0-6 5.686-6 10a6 6 0 0 0 6 6M6.646 4.646l.708.708c-.29.29-1.128 1.311-1.907 2.87l-.894-.448c.82-1.641 1.717-2.753 2.093-3.13" />
                                </svg> 0 - 100
                            </div>
                            Newbie
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <img src="/img/ranks/scout.png" class="img-fluid" width="40px" />
                                <svg xmlns="http://www.w3.org/2000/svg" width="1.5rem" height="1.5rem" fill="#431264" class="bi bi-droplet-fill" viewBox="0 0 16 16">
                                    <path d="M8 16a6 6 0 0 0 6-6c0-1.655-1.122-2.904-2.432-4.362C10.254 4.176 8.75 2.503 8 0c0 0-6 5.686-6 10a6 6 0 0 0 6 6M6.646 4.646l.708.708c-.29.29-1.128 1.311-1.907 2.87l-.894-.448c.82-1.641 1.717-2.753 2.093-3.13" />
                                </svg> 101 - 600
                            </div>
                            Scout
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <img src="/img/ranks/captain.png" class="img-fluid" width="40px" />
                                <svg xmlns="http://www.w3.org/2000/svg" width="1.5rem" height="1.5rem" fill="#431264" class="bi bi-droplet-fill" viewBox="0 0 16 16">
                                    <path d="M8 16a6 6 0 0 0 6-6c0-1.655-1.122-2.904-2.432-4.362C10.254 4.176 8.75 2.503 8 0c0 0-6 5.686-6 10a6 6 0 0 0 6 6M6.646 4.646l.708.708c-.29.29-1.128 1.311-1.907 2.87l-.894-.448c.82-1.641 1.717-2.753 2.093-3.13" />
                                </svg> 601 - 1700
                            </div>
                            Captain
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <img src="/img/ranks/titan.png" class="img-fluid" width="40px" />
                                <svg xmlns="http://www.w3.org/2000/svg" width="1.5rem" height="1.5rem" fill="#431264" class="bi bi-droplet-fill" viewBox="0 0 16 16">
                                    <path d="M8 16a6 6 0 0 0 6-6c0-1.655-1.122-2.904-2.432-4.362C10.254 4.176 8.75 2.503 8 0c0 0-6 5.686-6 10a6 6 0 0 0 6 6M6.646 4.646l.708.708c-.29.29-1.128 1.311-1.907 2.87l-.894-.448c.82-1.641 1.717-2.753 2.093-3.13" />
                                </svg> 1700 - 3000
                            </div>
                            Titan
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <img src="/img/ranks/moderator.png" class="img-fluid" width="40px" />
                                <svg xmlns="http://www.w3.org/2000/svg" width="1.5rem" height="1.5rem" fill="#431264" class="bi bi-droplet-fill" viewBox="0 0 16 16">
                                    <path d="M8 16a6 6 0 0 0 6-6c0-1.655-1.122-2.904-2.432-4.362C10.254 4.176 8.75 2.503 8 0c0 0-6 5.686-6 10a6 6 0 0 0 6 6M6.646 4.646l.708.708c-.29.29-1.128 1.311-1.907 2.87l-.894-.448c.82-1.641 1.717-2.753 2.093-3.13" />
                                </svg> > 3000
                            </div>
                            Moderator
                        </li>
                    </ul>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <p class="text-muted">печели еликсир чрез създаване на икони и писане на ревюта</p>
                </div>
            </div>
        </div>
    </div>
</div>