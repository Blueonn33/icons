@using icons.Models.Reviews
@model icons.Models.Icons.IconViewModel;
@{
    ViewData["Title"] = "Icon";
}

<head>
    <link rel="stylesheet" href="~/css/icons/index.css" asp-append-version="true" />
</head>
<body class="icon-container">
    <section class="container">
        <a asp-action="Index" asp-controller="Icons" class="btn btn-secondary">назад</a>
    </section>
    <section class="container mt-5">
        <div class="row gap-5">
            <div class="col-sm-12 col-md-4 d-flex justify-content-center ps-0">
                <div class="d-flex justify-content-sm-center me-3">
                    <img src="@Model.ImageUrl" class="img-fluid rounded-5 current-icon-image d-inline-block"/>
                </div>
                <div class="vr vr-blurry d-none d-md-block"></div>
            </div>
            <div class="col-sm-12 col-md-6 d-flex flex-column">
                <hr class="text-light" />
                <div class="mb-5">
                    <h1 class="fs-2 text-light"><strong class="text-dark">икона: </strong>@Model.Title</h1>
                </div>
                <hr class="text-light"/>
                <div class="text-light">
                    <p><strong class="text-info">описание: </strong>@Model.Description</p>
                </div>
                <div class="text-light">
                    <p class="mb-0"><strong class="text-info">оценка: </strong>@($"{Model.AverageRating:F2}")</p>
                </div>
                <hr class="text-light"/>
                <div class="text-light d-flex align-items-center mt-5">
                    <span><strong class="text-info">публикувано от:</strong></span>
                    <img src="@Model.UserProfilePictureUrl" class="img-fluid rounded-circle mx-3 icon-user-profile"/>
                    <a asp-action="UserProfile" asp-controller="Users" asp-route-id="@Model.UserId" class="d-inline-block mb-0 text-light">@Model.Username</a>
                </div>
                <hr class="text-light"/>
            </div>
        </div>
    </section>
    <section>
        @await Html.PartialAsync(
            "~/Views/Reviews/_Reviews.cshtml",
            new ReviewsViewModel
            {
                Reviews = Model.Reviews,
                IconId = Model.Id,
                UserId = Model.UserId,
                Sort = Model.Sort,
                RankImageUrl = Model.RankImageUrl,
                Rank = Model.Rank
            }
        )
    </section>
</body>