@using icons.Models.Reviews
@model icons.Models.Icons.IconViewModel;
@{
    ViewData["Title"] = "Icon";
}

<head>
    <link rel="stylesheet" href="~/css/icons/index.css" asp-append-version="true" />
</head>
<body class="icon-container">
    <section class="container">
        <a asp-action="Index" asp-controller="Icons" class="btn btn-secondary">back</a>
    </section>
    <section class="container mt-5">
        <div class="row">
            <div class="col-4 d-flex justify-content-between gap-5 ps-0">
                <div>
                    <img src="@Model.ImageUrl" class="img-fluid rounded-5"/>
                </div>
                <div class="vr vr-blurry"></div>
            </div>
            <div class="col-8 d-flex flex-column justify-content-center">
                <hr class="text-light" />
                <div class="mb-5">
                    <h1 class="fs-2 text-light"><strong class="text-dark">icon: </strong>@Model.Title</h1>
                </div>
                <hr class="text-light"/>
                <div class="text-light">
                    <p><strong class="text-dark">description: </strong>@Model.Description</p>
                </div>
                <div class="text-light">
                    <p class="mb-0"><strong class="text-dark">average rating: </strong>@Model.AverageRating</p>
                </div>
                <hr class="text-light"/>
                <div class="text-light d-flex align-items-center mt-5">
                    <span><strong class="text-dark">posted by:</strong></span>
                    <img src="@Model.UserProfilePictureUrl" class="img-fluid rounded-circle mx-3" width="50"/>
                    <p class="d-inline-block mb-0">@Model.Username</p>
                </div>
                <hr class="text-light"/>
            </div>
        </div>
    </section>
    <section>
        @await Html.PartialAsync(
            "~/Views/Reviews/_Reviews.cshtml",
            new ReviewsViewModel
            {
                Reviews = Model.Reviews,
                IconId = Model.Id
                // Sort = Model.Sort
            }
        )
    </section>
</body>