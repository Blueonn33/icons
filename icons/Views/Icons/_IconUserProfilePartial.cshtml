@model IconUserProfileViewModel

<input type="hidden" asp-for="@Model.Id" />
<div class="col d-flex justify-content-center mb-3">
    <div class="card" style="width: 18rem;">
        <div class="bg-image hover-overlay hover-zoom hover-shadow ripple">
            <img src="@Model.ImageUrl" class="w-100 card-img-top" />
            <a asp-action="Icon" asp-controller="Icons" asp-route-id="@Model.Id">
                <div class="mask" style="background-color: hsla(195, 83%, 58%, 0.2)"></div>
            </a>
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.Title</h5>
            <hr />
            <div class="d-flex justify-content-center">
                <a asp-action="Icon" asp-controller="Icons" asp-route-id="@Model.Id" class="btn btn-primary tracking-space">преглед</a>
            </div>

            @{
                var action = ViewContext.RouteData.Values["action"]!.ToString();
                var controller = ViewContext.RouteData.Values["controller"]!.ToString();
            }

            @if (controller == "Icons" && action == "Index")
            {
                <partial name="~/Views/Icons/_IconScriptsPartial.cshtml" model="Model" />
            }
        </div>
    </div>
</div>