@model icons.Models.Icons.IconsCreateViewModel;
@{
    ViewData["Title"] = "Create Icon";
}

<head>
    <link rel="stylesheet" href="~/css/icons/create.css" asp-append-version="true" />
</head>
<body class="icons-create-container">
    <section class="container mt-5">
        <form asp-action="CreateIcon" asp-controller="Icons" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @* <div class="form-floating mb-3">
                <input asp-for="ImageUrl" class="form-control" aria-required="true" required/>
                <label asp-for="ImageUrl">icon url</label>
            </div> *@
            <div class="form-floating mb-3">
                <input type="file" asp-for="ImageFile" class="form-control" accept="image/*" required/>
                <label asp-for="ImageFile">снимка</label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Title" class="form-control" aria-required="true" required />
                <label asp-for="Title">заглавие</label>
            </div>
            <div class="form-floating mb-3">
                <textarea asp-for="Description" class="form-control icon-description-create" aria-required="true" required></textarea>
                <label asp-for="Description">описание</label>
            </div>
            <div class="form-floating mb-3 d-flex justify-content-evenly mt-5">
                <a class="btn btn-light" asp-action="Index" asp-controller="Icons">назад</a>
                <button class="btn btn-primary" type="submit">създай</button>
            </div>
        </form>
    </section>
</body>