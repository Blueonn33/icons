@model IconsCreateViewModel;
@{
    ViewData["Title"] = "Create Icon";
    ViewData["BodyClass"] = "icons-create-body";
}

<div class="icons-create-container">
    <section class="container mt-5">
        <form asp-action="CreateIcon" asp-controller="Icons" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input type="file" asp-for="ImageFile" class="form-control" accept="image/*"/>
                <label asp-for="ImageFile">снимка</label>
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Title" class="form-control" aria-required="true"/>
                <label asp-for="Title">заглавие</label>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <textarea asp-for="Description" class="form-control icon-description-create" aria-required="true"></textarea>
                <label asp-for="Description">описание</label>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3 d-flex justify-content-evenly mt-5">
                <a class="btn btn-light" asp-action="Index" asp-controller="Icons">назад</a>
                <button class="btn btn-primary" type="submit">създай</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}