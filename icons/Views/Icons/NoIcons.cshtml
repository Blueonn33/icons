@{
    ViewData["Title"] = "No icons";
}

<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <section class="no-content-container">
        <div class="row">
            <div class="d-flex flex-column align-items-center justify-content-center col-6">
                <div class="mb-3">
                    <h1>no icons available</h1>
                </div>
                <div>
                    @{
                        if (User.Identity.IsAuthenticated)
                        {
                            <a asp-action="Create" asp-controller="Icons" class="btn btn-primary btn-lg btn-block">create</a>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg btn-block">create</a>
                        }
                    }
                </div>
            </div>
            <div class="col-6 p-0">
                <img src="img/no-content-image.png" class="img-fluid no-content-image"/>
            </div>
        </div>
    </section>
</body>