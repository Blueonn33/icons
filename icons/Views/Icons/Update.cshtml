@model icons.Models.Icons.IconsUpdateViewModel;
@{
    ViewData["Title"] = "Update Icon";
}

<head>

</head>
<body>
    <section class="container mt-5">
        <form asp-action="UpdateIcon" asp-controller="Icons">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            
            <input type="hidden" asp-for="Id" />

            <div class="form-floating mb-3">
                <input asp-for="ImageUrl" class="form-control" aria-required="true"/>
                <label asp-for="ImageUrl">icon url</label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Title" class="form-control" aria-required="true"/>
                <label asp-for="Title">title</label>
            </div>
            <div class="form-floating mb-3">
                <textarea asp-for="Description" class="form-control" aria-required="true"></textarea>
                <label asp-for="Description">description</label>
            </div>
            <div class="form-floating mb-3 d-flex justify-content-evenly mt-5">
                <a class="btn btn-secondary" asp-action="Index" asp-controller="Icons">BACK</a>
                <button class="btn btn-primary" type="submit">UPDATE</button>
            </div>
        </form>
    </section>
</body>