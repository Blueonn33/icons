@using System.Security.Claims
@using icons.Data.Constants
@using icons.Data.Enums
@using icons.Models.Icons
@model IconsViewModel
@{
    ViewData["Title"] = "Icons";
    ViewData["BodyClass"] = "icons-index-body";
}

<div class="icons-index-container">
    <section class="container mt-5">
        <div class="row d-flex justify-content-center">
            <div class="col-4">
                @{
                    if (User.Identity.IsAuthenticated)
                    {
                        <a asp-action="Create" asp-controller="Icons" class="btn btn-primary btn-lg btn-block">създай</a>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg btn-block">създай</a>
                    }
                }
            </div>
        </div>
    </section>
    <section class="container mt-3">
        <div class="row d-flex justify-content-end">
            <div class="col-sm-4 col-md-3 col-lg-3 col-xl-2">
                <form method="get" asp-action="Index" asp-controller="Icons">
                    <select class="form-select" asp-for="Sort"
                            asp-items="Html.GetEnumSelectList<EnumIconSortOptions>()"
                            onchange="this.form.submit()">
                    </select>
                </form>
            </div>
        </div>
    </section>
    <section class="container d-flex justify-content-around mt-5">
        <div class="row">
            @foreach (var icon in Model.GetAllIcons)
            {
                <partial name="_IconPartial.cshtml" model="icon"/>
            }
        </div>
    </section>
    <section>
        <button id="backToTop" class="back-to-top">
            ↑
        </button>
    </section>
</div>

@section Scripts
{
    <script name="_ScrollPartial.cshtml"></script>
}