@using icons.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<link href="css/site.css"/>

<ul class="navbar-nav d-flex align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);

    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            <img class="img-fluid rounded-circle nav-profile-pic" src="@user.ProfilePictureUrl" alt="profile picture"/>
        </a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark fs-5" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark fs-5" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
