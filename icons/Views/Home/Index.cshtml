@using icons.Models.Home
@model Top3IconsViewModel;
@{
    ViewData["Title"] = "Home Page";
}

<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div>
        <section class="bg-kuchiki px-0">
                <div class="row px-0 mx-0">
                    <div class="col ps-5 d-flex align-items-center bg-transparent glass">
                        <div class=" p-2 pe-5 rounded-3">
                            <div>
                                <h1 class="display-2 text-info mb-5">
                                    icons
                                    <svg xmlns="http://www.w3.org/2000/svg" width="0.7em" height="0.7em" fill="currentColor" class="bi bi-back" viewBox="0 0 16 16">
                                        <path d="M0 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"/>
                                    </svg>
                                </h1>
                            </div>
                            <div>
                                <h2 class="display-5 text-light">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-check-all" viewBox="0 0 16 16">
                                        <path d="M8.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L2.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093L8.95 4.992zm-.92 5.14.92.92a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 1 0-1.091-1.028L9.477 9.417l-.485-.486z"/>
                                    </svg>
                                    create a free account
                                </h2>
                            <hr class="text-light" />
                            </div>
                            <div>
                                <h2 class="display-5 text-light">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-check-all" viewBox="0 0 16 16">
                                        <path d="M8.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L2.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093L8.95 4.992zm-.92 5.14.92.92a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 1 0-1.091-1.028L9.477 9.417l-.485-.486z"/>
                                    </svg>
                                    browse a wide variety of icons
                                </h2>
                                <hr class="text-light"/>
                            </div>
                            <div>
                                <h2 class="display-5 text-light">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-check-all" viewBox="0 0 16 16">
                                        <path d="M8.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L2.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093L8.95 4.992zm-.92 5.14.92.92a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 1 0-1.091-1.028L9.477 9.417l-.485-.486z"/>
                                    </svg>
                                    publish your own icons
                                </h2>
                            <hr class="text-light" />
                            </div>
                            <div class="mt-5 d-flex justify-content-center">
                                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-lg btn-outline-info text-uppercase btn-register-home">register</a>
                            </div>
                        </div>
                    </div>
                    <div class="col px-0 mx-0">
                        <img src="~/img/kuchiki.png" class="img-fluid" />
                    </div>
                </div>
        </section>
        <section class="bg-dark py-5">
            <div class="container">
                <div class="text-center">
                    <h2 class="text-light pb-4">⭐ our top rated icons ⭐</h2>
                </div>
                <div class="row">
                    @foreach (var icon in Model.Top3Icons)
                    {
                        <div class="col d-flex justify-content-center">
                            <div class="card" style="width: 18rem;">
                                <div class="bg-image hover-overlay hover-zoom hover-shadow ripple">
                                    <img src="@icon.ImageUrl" class="w-100 card-img-top" />
                                    <a href="#">
                                        <div class="mask" style="background-color: hsla(195, 83%, 58%, 0.2)"></div>
                                    </a>
                                </div>

                                @* <img class="card-img-top" src="@icon.ImageUrl" alt="Card image"> *@
                                <div class="card-body">
                                    <h5 class="card-title">@icon.Title</h5>
                                    <p class="card-text">@icon.Description</p>
                                    <a href="#" class="btn btn-primary">Go somewhere</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
</body>
