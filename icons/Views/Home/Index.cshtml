@using icons.Data.Models
@using icons.Models.Home
@model Top3IconsViewModel;
@{
    ViewData["Title"] = "Home Page";
    ViewData["BodyClass"] = "body-white";
}

<div class="body-container">
    <section class="bg-kuchiki px-0">
        <div class="row px-0 mx-0">
            <div class="col-sm-12 col-md-6 ps-5 d-flex align-items-center bg-transparent glass">
                <div class="p-2 pe-5 rounded-3">
                    <partial name="_FeaturesPartial.cshtml"/>
                    <div class="mb-3 mt-5 d-flex justify-content-center">
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-lg btn-outline-info text-uppercase btn-register-home">регистрация</a>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-6 px-0 mx-0 pt-2">
                <img src="~/img/kuchiki.png" class="img-fluid" />
            </div>
        </div>
    </section>
    <section class="bg-dark py-5 mb-0">
        <div class="container">
            <div class="text-center">
                <h2 class="text-light pb-4">⭐ нашите най-високо оценени икони ⭐</h2>
            </div>
            <div class="row">
                @foreach (var icon in Model.Top3Icons)
                {
                    <partial name="~/Views/Icons/_IconPartial.cshtml" model="icon"/>
                }
            </div>
        </div>
    </section>
</div>