@page
@model EmailModel
@{
    ViewData["Title"] = "промяна на email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<head>
    <link rel="stylesheet" href="~/css/users/personal-profile.css" asp-append-version="true" />
</head>

<section class="container user-profile-container">
    <h3 class="mb-5">@ViewData["Title"]</h3>
    <partial name="_StatusMessage" for="StatusMessage" />
    <div class="row">
        <div class="col-md-4">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-6">
            <form id="email-form" method="post">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                @if (Model.IsEmailConfirmed)
                {
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="моля, въведи email" disabled/>
                        <label asp-for="Email" class="form-label">email</label>
                    </div>
                }
                else
                {
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="моля, въведи email" disabled />
                        <label asp-for="Email" class="form-label">email</label>
                        <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link">изпрати потвърждение</button>
                    </div>
                }
                <div class="form-floating mb-3">
                    <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="моля, въведи нов email" />
                    <label asp-for="Input.NewEmail" class="form-label">нов email</label>
                    <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                </div>
                <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-lg btn-primary">запази</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
