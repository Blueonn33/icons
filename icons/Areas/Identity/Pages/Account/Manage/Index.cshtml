@page
@model IndexModel
@{
    ViewData["Title"] = "профил";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<head>
    <link rel="stylesheet" href="~/css/users/personal-profile.css" asp-append-version="true" />
</head>
<body class="user-profile-container">
    <section class="container">
        <h3 class="mb-5">@ViewData["Title"]</h3>
        <partial name="_StatusMessage" for="StatusMessage" />
        <div class="row">
            <div class="col-md-4">
                <partial name="_ManageNav" />
            </div>
            <div class="col-md-6">
                <form id="profile-form" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3 d-flex justify-content-center">
                        <img src="@Model.CurrentUser.ProfilePictureUrl" class="img-fluid rounded-3 user-profile-img" />
                    </div>
                    <div class="form-floating mb-3">
                        <input type="file" asp-for="Input.ProfilePictureFile" class="form-control" accept="image/*" />
                        <label asp-for="Input.ProfilePictureFile" class="form-label">снимка</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Name" class="form-control" placeholder="моля, въведи име" />
                        <label asp-for="Input.Name" class="form-label">име</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control" placeholder="моля, въведи email" disabled />
                        <label asp-for="Username" class="form-label">email</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder=""/>
                        <label asp-for="Input.PhoneNumber" class="form-label">телефон</label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">запази</button>
                </form>
            </div>
        </div>
    </section>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
