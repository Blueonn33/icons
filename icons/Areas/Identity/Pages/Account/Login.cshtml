@page
@model LoginModel

@{
    ViewData["Title"] = "вход";
}

<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <section class="row d-flex justify-content-center px-0 mx-0 nel-theme body-container">
        <div class="col-sm-12 col-md-10 col-lg-6 col-xl-4 mt-5">
            <h1 class="mb-5">@ViewData["Title"]</h1>
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                    <label asp-for="Input.Email" class="form-label">email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div
                <div class="form-floating mb-3">
                    <div class="input-group">
                        <div class="form-floating flex-grow-1">
                            <input asp-for="Input.Password"
                                   class="form-control"
                                   aria-required="true"
                                   id="passwordInput" />
                            <label asp-for="Input.Password">парола</label>
                        </div>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="togglePassword"
                                aria-label="Покажи паролата">
                            👁️
                        </button>
                    </div>

                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">вход</button>
                </div>
                <div class="mt-5">
                    <p>
                        <a class="text-dark login-offset" id="forgot-password" asp-page="./ForgotPassword">Забрави ли паролата?</a>
                    </p>
                    <p>
                        <a class="text-dark login-offset" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Регистрирай се като нов потребител</a>
                    </p>
                    <p>
                        <a class="text-dark login-offset" id="resend-confirmation" asp-page="./ResendEmailConfirmation">Изпращане на потвърждение на имейл</a>
                    </p>
                </div>
            </form>
        </div>
        <div class="col-sm-12 col-md-6 d-flex justify-content-center">
            <img src="~/img/nel.png" class="img-fluid login-image" alt="nel" />
        </div>
    </section>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.getElementById("togglePassword").addEventListener("click", function() {
            const password = document.getElementById("passwordInput");
            if (password.type === "password") {
                password.type = "text";
                this.textContent = "🙈";
                this.setAttribute("aria-label", "Скрий паролата");
            } else {
                password.type = "password";
                this.textContent = "👁️";
                this.setAttribute("aria-label", "Покажи паролата");
            }
        });
        document.getElementById("toggleConfirmPassword").addEventListener("click", function() {
            const password = document.getElementById("confirmPasswordInput");
            if (password.type === "password") {
                password.type = "text";
                this.textContent = "🙈";
                this.setAttribute("aria-label", "Скрий паролата");
            } else {
                password.type = "password";
                this.textContent = "👁️";
                this.setAttribute("aria-label", "Покажи паролата");
            }
        });
    </script>
}
