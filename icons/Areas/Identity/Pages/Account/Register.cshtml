@page
@model RegisterModel
@{
    ViewData["Title"] = "регистрация";
}

<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <section class="row d-flex justify-content-center px-0 mx-0 mikasa-theme body-container">
        <div class="col-sm-12 col-md-10 col-lg-6 col-xl-4 mt-5">
            <h1 class="mb-5 text-light">@ViewData["Title"]</h1>
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input type="file" asp-for="Input.ProfilePictureFile" class="form-control" accept="image/*" />
                    <label asp-for="Input.ProfilePictureFile">профилна снимка</label>
                    <span asp-validation-for="Input.ProfilePictureFile" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Name" class="form-control" autocomplete="name" aria-required="true" />
                    <label asp-for="Input.Name">име</label>
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                    <label asp-for="Input.Email">email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <div class="input-group">
                        <div class="form-floating flex-grow-1">
                            <input asp-for="Input.Password"
                                   class="form-control"
                                   aria-required="true"
                                   id="passwordInput" />
                            <label asp-for="Input.Password">парола</label>
                        </div>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="togglePassword"
                                aria-label="Покажи паролата">
                            👁️
                        </button>
                    </div>

                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <div class="input-group">
                        <div class="form-floating flex-grow-1">
                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   id="confirmPasswordInput" />
                            <label asp-for="Input.ConfirmPassword">потвърди парола</label>
                        </div>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="toggleConfirmPassword"
                                aria-label="Покажи паролата">
                            👁️
                        </button>
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary tracking-space">регистрация</button>
                <div class="mt-5">
                    <p>
                        <a class="text-light login-offset" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Вече имаш профил? Влез</a>
                    </p>
                </div>
            </form>
        </div>
        <div class="col-sm-12 col-md-6 d-flex justify-content-center">
            <img src="~/img/mikasa.png" class="img-fluid register-image" alt="mikasa" />
        </div>
    </section>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.getElementById("togglePassword").addEventListener("click", function() {
            const password = document.getElementById("passwordInput");
            if (password.type === "password") {
                password.type = "text";
                this.textContent = "🙈";
                this.setAttribute("aria-label", "Скрий паролата");
            } else {
                password.type = "password";
                this.textContent = "👁️";
                this.setAttribute("aria-label", "Покажи паролата");
            }
        });
        document.getElementById("toggleConfirmPassword").addEventListener("click", function() {
            const password = document.getElementById("confirmPasswordInput");
            if (password.type === "password") {
                password.type = "text";
                this.textContent = "🙈";
                this.setAttribute("aria-label", "Скрий паролата");
            } else {
                password.type = "password";
                this.textContent = "👁️";
                this.setAttribute("aria-label", "Покажи паролата");
            }
        });
    </script>
}
