{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequiredUniqueChars": 2,
      "RequireNonAlphanumeric": true,
      "RequiredLength": 6
    },
    "SignIn": {
      "RequireConfirmedAccount": false
    },
    "User": {
      "RequireUniqueEmail": true
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  }
}
